{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/css/:path*", "destination": "https://rejson59.github.io/css/:path*" },
    { "source": "/js/:path*", "destination": "https://rejson59.github.io/js/:path*" },
    { "source": "/data/:path*", "destination": "https://rejson59.github.io/data/:path*" },
    { "source": "/vendor/:path*", "destination": "https://rejson59.github.io/vendor/:path*" },
    { "source": "/assets/:path*", "destination": "https://rejson59.github.io/assets/:path*" },
    { "source": "/rejson-widgets/:path*", "destination": "https://rejson59.github.io/rejson-widgets/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(w-budowie|login)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
