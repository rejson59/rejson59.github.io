{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/rejchat",
      "destination": "/rejchat.html"
    },
    {
      "source": "/css/:path*",
      "destination": "https://rejson59.github.io/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "https://rejson59.github.io/js/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "https://rejson59.github.io/data/:path*"
    },
    {
      "source": "/vendor/:path*",
      "destination": "https://rejson59.github.io/vendor/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://rejson59.github.io/assets/:path*"
    },
    {
      "source": "/rejson-widgets/:path*",
      "destination": "https://rejson59.github.io/rejson-widgets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/push-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/hub/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/js/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/css/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://esm.sh https://api.deezer.com https://itunes.apple.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://hzbqzfimtroixnldzjeq.supabase.co https://*.supabase.co https://api.openai.com https://api.deezer.com https://itunes.apple.com; worker-src 'self' blob:; frame-src 'self' https://open.spotify.com https://www.youtube.com https://w.soundcloud.com https://widget.deezer.com; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(w-budowie|login)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tablica-pomyslow",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tablica-pomyslow.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/board",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rejson-widgets/board",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rejson-widgets/board.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/widzety",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/widzety.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
