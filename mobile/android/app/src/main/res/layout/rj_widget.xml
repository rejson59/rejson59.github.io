<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rj_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:text="@string/rj_widget_title"
        android:textColor="#8BBDFF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rj_widget_chat"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/rj_widget_button"
            android:gravity="center"
            android:text="@string/rj_widget_chat"
            android:textColor="#E8F2FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rj_widget_file"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/rj_widget_button"
            android:gravity="center"
            android:text="@string/rj_widget_file"
            android:textColor="#E8F2FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rj_widget_sejf"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/rj_widget_button"
            android:gravity="center"
            android:text="@string/rj_widget_sejf"
            android:textColor="#E8F2FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rj_widget_class"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/rj_widget_button"
            android:gravity="center"
            android:text="@string/rj_widget_class"
            android:textColor="#E8F2FF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
