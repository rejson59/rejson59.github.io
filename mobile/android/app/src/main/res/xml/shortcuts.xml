<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="rejchat"
        android:shortcutLongLabel="@string/rj_shortcut_chat_long"
        android:shortcutShortLabel="@string/rj_shortcut_chat">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://rejhub.vercel.app/rejchat"
            android:targetClass="pl.rejson59.rejhub.MainActivity"
            android:targetPackage="pl.rejson59.rejhub" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:enabled="true"
